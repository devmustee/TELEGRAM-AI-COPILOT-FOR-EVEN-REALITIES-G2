# Server
PORT=3001
HOST=0.0.0.0
NODE_ENV=development

# CORS (G2 WebView dev server or hosted Even Hub origin)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# PostgreSQL
DATABASE_URL=postgres://postgres:postgres@localhost:5432/telegram_ai_copilot

# Security (32+ byte hex or random string for AES-256-GCM session encryption & tokens)
SESSION_ENCRYPTION_KEY=replace_with_64_hex_chars_for_aes_256_gcm_session_encryption_key
PAIRING_CODE_TTL_SECONDS=600

# Telegram MTProto Client API (from https://my.telegram.org)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# OpenAI API (for summarization, reply suggestions, contextual Q&A, and Whisper STT)
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_STT_MODEL=whisper-1
